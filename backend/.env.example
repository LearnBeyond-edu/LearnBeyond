PORT=5000
NODE_ENV=production

# Database Configuration (Neon PostgreSQL)
# Example: postgresql://username:password@ep-xxxx.neon.tech/learnbeyondbd?sslmode=require
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Local Database fallback (if DATABASE_URL is not set)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password
DB_NAME=learnbeyond_db

# CORS Configuration (Set to your Netlify site URL)
CLIENT_URL=https://your-app.netlify.app

# Authentication
JWT_SECRET=your_super_secret_jwt_key
JWT_EXPIRES_IN=1d

# Uploads
UPLOAD_DIR=uploads/
MAX_FILE_SIZE=5242880 # 5MB in bytes

# AI Integration
GROQ_API_KEY=your_groq_api_key
GEMINI_API_KEY=your_gemini_api_key

